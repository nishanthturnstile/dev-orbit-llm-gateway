# Placeholder-only LibreChat staging variables.
# Copy to an ignored local file or set as sealed Railway variables.

HOST=0.0.0.0
PORT=3080
ENDPOINTS=custom

# LibreChat data stores. Do not use LiteLLM Postgres.
MONGO_URI=<sealed-authenticated-librechat-mongodb-private-uri-with-authSource-admin>
MEILI_HOST=http://<librechat-meilisearch-private-host>:7700
MEILI_MASTER_KEY=<sealed-meilisearch-master-key>
SEARCH=true

# Scoped LiteLLM virtual key for this UI only.
LITELLM_BASE_URL=https://<litellm-staging-domain>/v1
LITELLM_UI_API_KEY=<sealed-librechat-eval-litellm-virtual-key>

# App secrets. Generate and seal per environment.
CREDS_KEY=<sealed-librechat-creds-key>
CREDS_IV=<sealed-librechat-creds-iv>
JWT_SECRET=<sealed-librechat-jwt-secret>
JWT_REFRESH_SECRET=<sealed-librechat-jwt-refresh-secret>

# Access controls.
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=false
ALLOW_SOCIAL_LOGIN=false
ALLOW_SOCIAL_REGISTRATION=false
ALLOW_PASSWORD_RESET=false
ALLOW_UNVERIFIED_EMAIL_LOGIN=false
DEBUG_LOGGING=false
DEBUG_CONSOLE=false

# Staging URL placeholders.
DOMAIN_SERVER=https://<librechat-staging-domain>
DOMAIN_CLIENT=https://<librechat-staging-domain>

# Data-service variables. Set shared secrets independently on each service that needs them.
MONGO_INITDB_ROOT_USERNAME=<librechat-mongo-user>
MONGO_INITDB_ROOT_PASSWORD=<sealed-librechat-mongo-password>
MEILI_HTTP_ADDR=[::]:7700
POSTGRES_DB=<librechat-vector-db-name>
POSTGRES_USER=<librechat-vector-db-user>
POSTGRES_PASSWORD=<sealed-librechat-vector-db-password>
DB_HOST=<librechat-vectordb-private-host>
DB_PORT=5432

# RAG service placeholders.
RAG_API_URL=http://<librechat-rag-api-private-host>:8000
RAG_PORT=8000
RAG_OPENAI_BASEURL=https://<litellm-staging-domain>/v1
RAG_OPENAI_API_KEY=<sealed-librechat-eval-litellm-virtual-key>
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=dev-embed
