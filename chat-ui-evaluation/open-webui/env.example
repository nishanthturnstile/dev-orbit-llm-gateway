# Placeholder-only Open WebUI staging variables.
# Copy to an ignored local file or set as sealed Railway variables.

OPENAI_API_BASE_URL=https://<litellm-staging-domain>/v1
OPENAI_API_KEY=<sealed-open-webui-eval-litellm-virtual-key>

WEBUI_AUTH=True
WEBUI_SECRET_KEY=<sealed-stable-open-webui-secret>
ENABLE_SIGNUP=False
ENABLE_LOGIN_FORM=True
ENABLE_OAUTH_SIGNUP=False
DEFAULT_USER_ROLE=user
ENABLE_DIRECT_CONNECTIONS=False
ENABLE_OLLAMA_API=False

# Route Open WebUI knowledge/RAG embeddings through LiteLLM, not local models or direct providers.
RAG_EMBEDDING_ENGINE=openai
RAG_OPENAI_API_BASE_URL=https://<litellm-staging-domain>/v1
RAG_OPENAI_API_KEY=<sealed-open-webui-eval-litellm-virtual-key>
RAG_EMBEDDING_MODEL=dev-embed

# Use either a Railway volume at /app/backend/data or a separate UI database.
# Do not point this at LiteLLM Postgres.
DATABASE_URL=<optional-separate-open-webui-database-url>

# Telemetry/analytics controls where supported.
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# Optional application URL placeholder.
WEBUI_URL=https://<open-webui-staging-domain>
