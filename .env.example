# Placeholder names only. Do not put real secrets, generated virtual keys,
# Railway values, provider URLs, database URLs, or private hostnames here.

# Runtime
ENVIRONMENT=staging
PORT=4000
PROXY_BASE_URL=<public-api-base-url-for-metadata-only>

# LiteLLM
LITELLM_MASTER_KEY=<generated-litellm-master-key-with-required-prefix>
LITELLM_SALT_KEY=<sealed-litellm-salt-key>
DATABASE_URL=<railway-postgres-private-reference>
NO_DOCS=True
NO_REDOC=True
NO_OPENAPI=True
DISABLE_ADMIN_UI=true

# Admin UI
UI_USERNAME=<admin-username>
UI_PASSWORD=<strong-admin-password>

# Provider credentials
OPENAI_API_KEY=<sealed-openai-api-key>
ANTHROPIC_API_KEY=<sealed-anthropic-api-key>
FIREWORKS_AI_API_KEY=<sealed-fireworks-ai-api-key>
PERPLEXITY_API_KEY=<sealed-perplexity-api-key>

# Future backup worker
LITELLM_DATABASE_URL=<railway-postgres-private-reference>
BACKUP_ENCRYPTION_KEY=<sealed-backup-encryption-key>
BACKUP_TIER=daily
BACKUP_RETENTION_DAYS=30
BACKUP_RCLONE_DESTINATION=<rclone-remote:bucket-prefix>
RCLONE_CONFIG_BACKUP_TYPE=s3
RCLONE_CONFIG_BACKUP_PROVIDER=Other
RCLONE_CONFIG_BACKUP_ACCESS_KEY_ID=<backup-access-key-id>
RCLONE_CONFIG_BACKUP_SECRET_ACCESS_KEY=<sealed-backup-secret-access-key>
RCLONE_CONFIG_BACKUP_ENDPOINT=<backup-bucket-endpoint>
RCLONE_CONFIG_BACKUP_REGION=<backup-bucket-region>
RCLONE_CONFIG_BACKUP_ACL=private
RCLONE_CONFIG_BACKUP_URL_STYLE=path
RESTORE_DATABASE_URL=<restore-drill-postgres-private-reference>
RESTORE_TARGET_CONFIRMED=<fresh-restore-drill-required-for-restore-mode>
